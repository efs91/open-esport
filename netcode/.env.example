# Copier en .env (ne pas le versionner : il contient le jeton d'administration)
PUBLIC_HOST=jeu.mon-domaine.fr        # adresse ou IP publique vue par les joueurs
ACCOUNTS_KEY=change-moi-aussi           # clé partagée entre le matchmaking et le service de comptes :  openssl rand -hex 24
OE_ADMIN_TOKEN=change-moi             # long et aléatoire :  openssl rand -hex 24
MAPS_DIR=/opt/open-esport/maps        # dossier des .world sur la machine (même chemin dans le conteneur)
CONFIG_DIR=/opt/open-esport/config     # y copier balance.json (netcode/balance.json), même chemin dans le conteneur
GAME_PORTS=27100-27199
PLAYERS=30
MIN_PLAYERS=1
LOBBY_COUNTDOWN=5                     # secondes d'attente avant le départ de la partie
GAME_CPUS=2
GAME_MEMORY=1g

# Tournois : clé API de ManageComp (facultatif)
MANAGECOMP_API_KEY=
MANAGECOMP_URL=https://api.managecomp.org
