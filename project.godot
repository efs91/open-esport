; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ambientcg]

download_path="res://addons/ambientcg/Downloads/"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Open Esport"
run/main_scene="uid://d15rdh65of1ls"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/open-esport-2025"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cvxwpkmxlu8gt"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="open-esport"

[editor_plugins]

enabled=PackedStringArray("res://addons/ambientcg/plugin.cfg", "res://addons/fps-hands/plugin.cfg", "res://addons/open_esport_config/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

[rendering]

anti_aliasing/quality/msaa_3d=1
