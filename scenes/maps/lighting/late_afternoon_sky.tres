[gd_resource type="Sky" format=3]

[ext_resource type="Shader" path="res://shaders/afternoon_sky.gdshader" id="sky_shader"]

[sub_resource type="FastNoiseLite" id="cloud_shape"]
seed = 713
frequency = 0.013
fractal_octaves = 4

[sub_resource type="NoiseTexture2D" id="cloud_noise"]
width = 256
height = 256
seamless = true
noise = SubResource("cloud_shape")

[sub_resource type="ShaderMaterial" id="sky_mat"]
shader = ExtResource("sky_shader")
shader_parameter/cloud_noise = SubResource("cloud_noise")

[resource]
sky_material = SubResource("sky_mat")
